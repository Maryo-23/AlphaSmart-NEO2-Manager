        # Send button frame
        send_btn_frame = ttk.Frame(send_frame)
        send_btn_frame.grid(row=5, column=0, pady=(10, 0), sticky=(tk.W, tk.E))
        send_btn_frame.columnconfigure(0, weight=1)
        
        # Connection hint
        self.hint_var = tk.StringVar(value="Connect your NEO with USB to enable sending")
        self.hint_label = ttk.Label(send_btn_frame, textvariable=self.hint_var, font=("Helvetica", 9, "italic"), foreground="red")
        self.hint_label.grid(row=0, column=0, sticky=tk.W)
        
        # Send button (always visible, disabled state is clear)
        self.send_btn = ttk.Button(send_btn_frame, text="Send to NEO", command=self.send_file, state=tk.DISABLED)
        self.send_btn.grid(row=0, column=1, sticky=tk.E, padx=(10, 0))
        
        # Files tab
        files_frame = ttk.Frame(self.notebook, padding="10")
        self.notebook.add(files_frame, text="NEO Files")
        files_frame.columnconfigure(0, weight=1)
