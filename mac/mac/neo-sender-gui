#!/usr/bin/env python3
"""
NEO Sender - GUI application to send files to AlphaSmart NEO 2
"""

import tkinter as tk
from tkinter import ttk, filedialog, messagebox, scrolledtext
import subprocess
import shutil
import os
import sys

# --- macOS .app bundle support (PyInstaller) -----------------------------
# When frozen, helper tools (neotools-cli, neo-format-neo2, pandoc) live
# next to the app executable in Contents/MacOS.
FROZEN = getattr(sys, "frozen", False)
BUNDLE_BIN = os.path.dirname(sys.executable) if FROZEN else ""
if FROZEN and os.path.exists(os.path.join(BUNDLE_BIN, "pandoc")):
    os.environ["NEO_PANDOC"] = os.path.join(BUNDLE_BIN, "pandoc")

