        slot_combo = ttk.Combobox(slot_frame, textvariable=self.slot_var, values=["1", "2", "3", "4", "5", "6", "7", "8"], width=5, state="readonly")
        slot_combo.grid(row=0, column=1, padx=(0, 10))
        
        ttk.Label(slot_frame, text="or Name:").grid(row=0, column=2, padx=(0, 5))
