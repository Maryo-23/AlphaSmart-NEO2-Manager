        self.notebook.add(send_frame, text="Send to NEO")
        send_frame.columnconfigure(0, weight=1)
        send_frame.rowconfigure(2, weight=1)
        
        # File selection
        file_frame = ttk.Frame(send_frame)
        file_frame.grid(row=0, column=0, sticky=(tk.W, tk.E), pady=(0, 10))
        file_frame.columnconfigure(1, weight=1)
        
        ttk.Label(file_frame, text="File:").grid(row=0, column=0, padx=(0, 5))
        self.file_path = tk.StringVar()
        self.file_entry = ttk.Entry(file_frame, textvariable=self.file_path)
        self.file_entry.grid(row=0, column=1, sticky=(tk.W, tk.E))
        ttk.Button(file_frame, text="Browse...", command=self.browse_file).grid(row=0, column=2, padx=(5, 0))
        
        # Slot selection
        slot_frame = ttk.Frame(send_frame)
